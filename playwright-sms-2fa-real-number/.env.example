# Real SMS run only (npm run test:sms). The local suite needs none of these.
MAILSLURP_API_KEY=
# The MailSlurp number that receives the code. The test reads its E.164 number from MailSlurp.
MAILSLURP_PHONE_ID=

# How the demo app sends its code: twilio or mailslurp.
SMS_PROVIDER=twilio

# SMS_PROVIDER=twilio: live credentials and an SMS-capable sender. Test credentials send nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMS_PROVIDER=mailslurp: a second MailSlurp number that sends the code. By default MailSlurp numbers
# only send to numbers that texted them first; ask support to allow your receiving test number.
MAILSLURP_SENDER_PHONE_ID=
