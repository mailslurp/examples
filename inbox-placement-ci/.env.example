# Copy to .env for a local run. In CI, set these as secrets and variables instead.
MAILSLURP_API_KEY=

# Your SMTP server or your ESP's SMTP relay (SendGrid, Postmark, Amazon SES, Mailgun, Resend, SMTP2GO...).
SMTP_HOST=
# 587 uses STARTTLS. 465 uses implicit TLS. Set SMTP_SECURE=true or false to override.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The From address your real emails use, on the domain you want to measure.
FROM_EMAIL=
FROM_NAME=

# Optional
# EMAIL_SUBJECT=Your weekly product update
# EMAIL_HTML_FILE=templates/sample-email.html
# PLACEMENT_GATE_PROVIDERS=gmail,outlook
# PLACEMENT_FAIL_ON_MISSING=false
# PLACEMENT_TIMEOUT_SECONDS=600
# PLACEMENT_SEGMENT=ALL_INBOXES
# PLACEMENT_REPORT_FILE=placement-report.json
