{
  "name": "inbox-placement-ci",
  "version": "1.0.0",
  "private": true,
  "description": "Run a MailSlurp inbox placement test from CI and fail the build when Gmail or Outlook seeds put the email in spam",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test 'test/**/*.test.ts'",
    "placement": "node src/run.ts"
  },
  "dependencies": {
    "mailslurp-client": "17.6.0",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "typescript": "5.9.3"
  }
}
