# Set these only for Appwrite staging runs. Only VITE_ values enter the browser.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
# Mock mode: the exact test number and fixed code configured in Appwrite.
APPWRITE_MOCK_PHONE=
APPWRITE_MOCK_CODE=
# SMS mode: a dedicated MailSlurp number ID; the runner looks up its E.164 value.
MAILSLURP_PHONE_ID=
MAILSLURP_API_KEY=
# Stable text unique to your staging project's SMS template (outside the OTP).
APPWRITE_SMS_MARKER=
